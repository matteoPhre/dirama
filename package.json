{
  "name": "@matteophre/dirama",
  "version": "1.0.0",
  "description": "Zero-dependency, framework-agnostic pipeline-engine for TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matteoPhre/dirama.git"
  },
  "homepage": "https://github.com/matteoPhre/dirama#readme",
  "bugs": {
    "url": "https://github.com/matteoPhre/dirama/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "pipeline",
    "orchestration",
    "middleware",
    "typescript",
    "async"
  ],
  "author": "matteoPhre",
  "license": "MIT"
}